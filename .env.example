# Supabase > Project Settings > API (or "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / "publishable" key. Safe to expose: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional bank sync (Plaid). Leave blank to hide bank linking. Server-only: never prefix with NEXT_PUBLIC_.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox or production
PLAID_ENV=sandbox
# 32 random bytes, base64. Generate: openssl rand -base64 32
PLAID_TOKEN_KEY=
# Optional, only for OAuth banks. Must be https (localhost works in sandbox) and registered in the Plaid dashboard.
PLAID_REDIRECT_URI=
